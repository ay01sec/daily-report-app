rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ヘルパー関数
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/companies/$(resource.data.companyId)/users/$(request.auth.uid)).data;
    }

    function isAdmin(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManagerOrAbove(companyId) {
      let role = get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.role;
      return role == 'admin' || role == 'manager' || role == 'office';
    }


    // メール送信コレクション（Cloud Functionsからのみ書き込み）
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // カスタム通知コレクション
    match /customNotifications/{notificationId} {
      // 読み取り：同一企業のadmin/manager
      allow read: if isAuthenticated() &&
        isManagerOrAbove(resource.data.companyId);

      // 作成・更新・削除：adminのみ
      allow create, update, delete: if isAuthenticated() &&
        isAdmin(request.resource.data.companyId);
    }

    // 企業コレクション（サブコレクション含む）
    match /companies/{companyId} {
      // 読み取り：未認証でも許可（企業コード検証のため）
      // ※ 企業基本情報のみ。機密情報は別途保護
      allow read: if true;
      // adminのみ企業情報を更新可能
      allow update: if isAuthenticated() && isAdmin(companyId);

      match /users/{userId} {
        allow read: if isAuthenticated();
        // 自分自身の更新、またはadminによる更新を許可
        allow update: if isAuthenticated() &&
          (request.auth.uid == userId || isAdmin(companyId));
        // 作成・削除はadminのみ
        allow create, delete: if isAuthenticated() && isAdmin(companyId);
      }

      match /employees/{employeeId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && isAdmin(companyId);
      }

      match /sites/{siteId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && isAdmin(companyId);
      }

      match /clients/{clientId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && isAdmin(companyId);
      }

      // 日報コレクション（サブコレクション）
      match /dailyReports/{reportId} {
        // 読み取り：自分が作成した日報、またはadmin/manager
        allow read: if isAuthenticated() && (
          resource.data.createdBy == request.auth.uid ||
          isManagerOrAbove(companyId)
        );

        // 作成：認証済みユーザー
        allow create: if isAuthenticated();

        // 更新：作成者本人（draft/signed/rejectedのみ）、またはadmin（承認操作）
        allow update: if isAuthenticated() && (
          (resource.data.createdBy == request.auth.uid &&
           resource.data.status in ['draft', 'signed', 'rejected']) ||
          isAdmin(companyId)
        );

        // 削除：adminのみ
        allow delete: if isAuthenticated() &&
          isAdmin(companyId);
      }
    }
  }
}
